    {
      "parameters": {
        "jsCode": "const response = await this.helpers.httpRequest({\n  method: 'GET',\n  url: 'http://host.docker.internal:5001/api/feature-flags/logs',\n  json: true\n});\nconst events = Array.isArray(response) ? response : [];\nconst now = Date.now();\nconst windowMs = 5 * 60 * 1000;\nconst recent = events.filter(e => (now - new Date(e.timestamp).getTime()) < windowMs);\nconst total = recent.length;\nconst errors = recent.filter(e => e.status === 'error').length;\nconst error_rate = total > 0 ? errors / total : 0;\nreturn [{ json: { error_rate: Math.round(error_rate * 1000) / 1000, total_events: total, error_events: errors, window_seconds: 300, feature_id: 'search_v2' } }];"
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000002",
      "name": "Read & Analyze Logs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:5001/api/feature-flags",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000003",
      "name": "Get Feature Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const logData = $('Read & Analyze Logs').first().json;\nconst allFeatures = $('Get Feature Status').first().json;\nconst featureId = logData.feature_id || 'search_v2';\nconst feature = allFeatures[featureId] || {};\nreturn [{ json: { ...logData, current_status: feature.status || 'unknown', current_traffic: feature.traffic_percentage || 0, feature_id: featureId } }];"
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000004",
      "name": "Merge Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.error_rate }}",
                    "rightValue": 0.05,
                    "operator": {
                      "type": "number",
                      "operation": "gt"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "deactivate"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.error_rate }}",
                    "rightValue": 0.01,
                    "operator": {
                      "type": "number",
                      "operation": "lt"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "reenable"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
