NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://localhost:27017/proshop
JWT_SECRET=change_me
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id

# ── M7 Privacy-Routing AI Assistant ───────────────────────────────
# Provider selection: 'mock' = deterministic, no network (autonomous tests/demo);
#                     'live' = real local/cloud models.
PROVIDER_MODE=mock

# Local model (Part 0). Ollama OpenAI-compatible endpoint by default.
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL_NAME=qwen3:8b-q8_0

# Cloud model via OpenRouter (one key, many models). Placeholder only — never commit a real key.
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional Presidio service for NAME detection (Stretch). Empty = regex-only routing.
PRESIDIO_URL=

# DZ2 security posture: 'secure' (default, deterministic scoped tools) | 'vuln' (attack demo only).
ASSISTANT_SECURITY=secure

# Pin mongodb-memory-server binary (arm64-compatible) so tests are reproducible.
# 6.0.14 is verified working with Mongoose 5.10.6 on Node 26 / arm64 (M0.0 smoke test).
MONGOMS_VERSION=6.0.14
