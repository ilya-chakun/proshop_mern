    {
      "parameters": {
        "name": "set_feature_state",
        "description": "Change the status of a feature flag. Input: JSON with feature_name (string) and state (string, one of Disabled/Testing/Enabled).",
        "method": "POST",
        "url": "http://host.docker.internal:5001/api/feature-flags/state",
        "sendBody": true,
        "specifyBody": "keypair",
        "parametersBody": {
          "values": [
            {
              "name": "feature_name",
              "value": "={{ $fromAI(\"feature_name\", \"The feature flag key\", \"string\") }}"
            },
            {
              "name": "state",
              "value": "={{ $fromAI(\"state\", \"Target state: Disabled, Testing, or Enabled\", \"string\") }}"
            }
          ]
        },
        "placeholderDefinitions": {
          "values": []
        }
      },
