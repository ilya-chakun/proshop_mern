      "parameters": {
        "name": "get_feature_info",
        "description": "Get current state of a feature flag. Input: JSON with feature_name (string). Returns status, traffic_percentage, dependencies.",
        "method": "GET",
        "url": "=http://host.docker.internal:5001/api/feature-flags/{{ $fromAI(\"feature_name\", \"The feature flag key e.g. search_v2\", \"string\") }}",
        "placeholderDefinitions": {
          "values": []
